# Optional nested environment overrides. Do not put real credentials in this file.
# Copy this file to .env only if your shell or local tooling loads it.

# Contact address included in the arXiv API User-Agent.
ARXIV_DIGEST_APP__ARXIV__CONTACT_EMAIL=researcher@example.org

# Examples of other operational overrides:
# ARXIV_DIGEST_APP__ARXIV__PAGE_SIZE=50
# ARXIV_DIGEST_APP__ARXIV__RATE_LIMIT_SECONDS=3.0
# ARXIV_DIGEST_APP__PATHS__DATA_DIR=data
# ARXIV_DIGEST_APP__PATHS__HISTORY_FILE=data/history.jsonl
# ARXIV_DIGEST_PROFILE__MAX_CANDIDATE_COUNT=200

# Optional OpenAI summaries. Keep the API key in your environment or untracked .env.
# OPENAI_API_KEY=
# OPENAI_SUMMARY_MODEL=
# OPENAI_EMBEDDING_MODEL=
# ARXIV_DIGEST_APP__SUMMARIZATION__PROVIDER=openai
